# Copy to .env.local for local development, or set in docker-compose.yml.

# Gate for /admin. Required. Use something long.
ADMIN_PASSWORD=change-me-to-something-long

# Signs the surgeon session cookie and the admin cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this logs everyone out; their /a/<token> link still works.
SESSION_SECRET=change-me-32-plus-random-characters

# Public origin, used to print /a/<token> links in seed:surgeons.
# Also decides whether cookies are marked Secure (https => Secure).
BASE_URL=http://localhost:3000

# Where frames, masks and app.db live. Defaults to ./data
# DATA_DIR=./data

# Invitation emails from the admin page (optional). With Gmail, only these two
# are needed: the address, and a Google app password made for it
# (Google Account > Security > 2-Step Verification > App passwords).
# SMTP_USER=theastarlab@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
#
# Anything else, only if you are not using Gmail's defaults:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=                # defaults to SMTP_USER
# INVITE_BCC=               # hidden copy of each invitation; defaults to MAIL_FROM, "none" for no copy
