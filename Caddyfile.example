# Caddy in front of the app: automatic HTTPS from Let's Encrypt, nothing else.
#
# Copy to /etc/caddy/Caddyfile on the VM, replace the domain and the email,
# then: sudo systemctl reload caddy
#
# DNS must already point at the VM's static IP before Caddy starts, or the
# certificate request will fail.

{
	# Let's Encrypt uses this only for expiry warnings.
	email you@example.org
}

study.example.org {
	encode zstd gzip

	# Mask uploads are small binary PNGs, but be explicit rather than unbounded.
	request_body {
		max_size 32MB
	}

	# The export streams a zip that can take minutes on a finished study.
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
	}

	# A surgeon's access token IS the URL: /a/<token>. Logging that path would
	# write a working credential into a file that is backed up, rotated and read
	# by anyone with shell access. These requests are excluded from the log
	# entirely; every other path is logged with its URI intact.
	@access_link path /a/*
	log_skip @access_link

	log {
		output file /var/log/caddy/study.log
		# Belt and braces: redact the query string on everything that IS logged,
		# in case a token ever ends up there.
		format filter {
			wrap console
			fields {
				request>uri query {
					replace redacted
				}
			}
		}
	}
}
